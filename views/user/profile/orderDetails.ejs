<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Order Details — Wooden Cot</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css" rel="stylesheet">

<style>
  /* ── Variables ── */
  :root {
    --brand:    #AE946D;
    --brand-dk: #9a8260;
    --brand-lt: #f5ede0;
    --text:     #2c2c2c;
    --muted:    #888;
    --border:   #e8e0d5;
    --white:    #ffffff;
    --bg:       #f9f6f2;
    --card-bg:  #fdfcfa;
    --green:    #2e7d32;
    --red:      #c0392b;
    --red-lt:   #fff0f0;
    --red-br:   #ffc9c9;
  }

  /* ── Base ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Poppins', sans-serif;
    background: var(--bg);
    color: var(--text);
    font-size: 16px;
  }

  /* ── Navbar / Footer ── */
  .navbar-custom { background-color: #AE946D; }
  .footer-custom { background-color: #CDAF82; }

  /* ── Page Header ── */
  .order-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 1.5rem;
  }
  .page-title {
    font-size: 22px;
    font-weight: 600;
    color: var(--brand);
    letter-spacing: .5px;
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
  }
  .page-title i { font-size: 20px; }
  .order-meta {
    font-size: 12px;
    color: var(--muted);
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .header-actions { display: flex; gap: 8px; flex-wrap: wrap; }
  .btn-back, .btn-invoice {
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
    font-family: 'Poppins', sans-serif;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    transition: .2s;
    border: 1px solid var(--border);
    cursor: pointer;
  }
  .btn-back {
    background: var(--white);
    color: var(--brand-dk);
  }
  .btn-back:hover { background: var(--brand-lt); color: var(--brand-dk); }
  .btn-invoice {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--white);
  }
  .btn-invoice:hover { background: var(--brand-dk); color: var(--white); }

  /* ── Card (same as wl-card) ── */
  .wl-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .wl-head {
    background: var(--brand-lt);
    border-bottom: 1.5px solid var(--border);
    padding: 12px 16px;
    font-size: 11px;
    font-weight: 600;
    color: var(--brand-dk);
    text-transform: uppercase;
    letter-spacing: .7px;
  }
  .wl-body { padding: 16px; }

  /* ── Items Table (same as cart wl-table) ── */
  .wl-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .wl-table thead tr {
    background: var(--brand-lt);
    border-bottom: 1.5px solid var(--border);
  }
  .wl-table thead th {
    padding: 12px 16px;
    font-size: 11px;
    font-weight: 600;
    color: var(--brand-dk);
    text-transform: uppercase;
    letter-spacing: .7px;
  }
  .wl-table thead th:nth-child(1) { width: 34%; }
  .wl-table thead th:nth-child(2) { width: 9%;  text-align: center; }
  .wl-table thead th:nth-child(3) { width: 13%; text-align: right; }
  .wl-table thead th:nth-child(4) { width: 13%; text-align: right; }
  .wl-table thead th:nth-child(5) { width: 18%; text-align: center; }
  .wl-table thead th:nth-child(6) { width: 13%; text-align: center; }

  .wl-table tbody tr { border-bottom: 1px solid #f0ebe3; transition: background .15s; }
  .wl-table tbody tr:last-child { border-bottom: none; }
  .wl-table tbody tr:hover { background: #fdf9f5; }
  .wl-table tbody td { padding: 14px 16px; vertical-align: middle; }
  .wl-table tbody td:nth-child(2) { text-align: center; }
  .wl-table tbody td:nth-child(3) { text-align: right; }
  .wl-table tbody td:nth-child(4) { text-align: right; }
  .wl-table tbody td:nth-child(5) { text-align: center; }
  .wl-table tbody td:nth-child(6) { text-align: center; }

  /* ── Product cell ── */
  .prod-cell { display: flex; align-items: center; gap: 14px; }
  .prod-img {
    width: 66px;
    height: 66px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid var(--border);
    background: #f0ebe3;
    flex-shrink: 0;
  }
  .prod-name {
    font-size: 13px;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 6px;
    line-height: 1.45;
  }
  .variant-badge {
    background: var(--brand-lt);
    border: 1px solid var(--border);
    color: var(--brand-dk);
    border-radius: 20px;
    font-size: 10px;
    font-weight: 600;
    padding: 2px 9px;
  }

  .qty-badge  { font-size: 13px; font-weight: 600; color: #555; }
  .price-val  { font-size: 13px; font-weight: 600; color: #555; }
  .total-val  { font-size: 13px; font-weight: 700; color: var(--text); }

  /* ── Status badges ── */
  .status-badge {
    font-size: 10.5px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 20px;
    display: inline-block;
    white-space: nowrap;
  }
  .st-pending    { background: #fff5e0; color: #b07d1a; }
  .st-shipped    { background: #e3f0fb; color: #2471a3; }
  .st-partial    { background: #e3f0fb; color: #2471a3; }
  .st-delivered  { background: #e4f4e6; color: #2e7d32; }
  .st-cancelled  { background: #fdeaea; color: #c0392b; }
  .st-requested  { background: #fdf3e3; color: #b07d1a; }
  .st-returned   { background: #efeaf6; color: #6c4ea0; }
  .st-rejected   { background: #fdeaea; color: #c0392b; }
  .status-sub {
    display: block;
    font-size: 10px;
    color: var(--muted);
    margin-top: 3px;
  }

  /* ── Per-item action buttons ── */
  .btn-item-cancel, .btn-item-return {
    background: none;
    border-radius: 8px;
    padding: 5px 14px;
    font-size: 11px;
    font-weight: 600;
    font-family: 'Poppins', sans-serif;
    cursor: pointer;
    transition: .2s;
  }
  .btn-item-cancel {
    border: 1px solid var(--red-br);
    color: var(--red);
  }
  .btn-item-cancel:hover { background: var(--red-lt); border-color: var(--red); }
  .btn-item-return {
    border: 1px solid var(--border);
    color: var(--brand-dk);
  }
  .btn-item-return:hover { background: var(--brand-lt); border-color: var(--brand); }
  .no-action { font-size: 11px; color: #ccc; }

  /* ── Address snapshot ── */
  .addr-type-badge {
    font-size: 10px;
    font-weight: 700;
    color: var(--brand);
    text-transform: uppercase;
    letter-spacing: .5px;
    background: var(--brand-lt);
    border: 1px solid var(--border);
    padding: 3px 10px;
    border-radius: 20px;
    display: inline-block;
    margin-bottom: 8px;
  }
  .addr-name { font-size: 13px; font-weight: 600; color: var(--text); margin-bottom: 3px; }
  .addr-line { font-size: 12px; color: var(--muted); line-height: 1.8; }

  /* ── Timeline ── */
  .timeline { position: relative; padding-left: 26px; }
  .timeline::before {
    content: "";
    position: absolute;
    left: 7px;
    top: 6px;
    bottom: 6px;
    width: 2px;
    background: var(--border);
  }
  .tl-step { position: relative; padding-bottom: 22px; }
  .tl-step:last-child { padding-bottom: 0; }
  .tl-dot {
    position: absolute;
    left: -26px;
    top: 3px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--white);
    border: 2px solid var(--border);
    z-index: 1;
  }
  .tl-step.done .tl-dot { background: var(--brand); border-color: var(--brand); }
  .tl-step.cancelled .tl-dot { background: var(--red); border-color: var(--red); }
  .tl-label { font-size: 13px; font-weight: 600; color: #bbb; }
  .tl-step.done .tl-label,
  .tl-step.cancelled .tl-label { color: var(--text); }
  .tl-date { font-size: 11px; color: #aaa; margin-top: 2px; }

  /* ── Summary (same as cart sum-card) ── */
  .sum-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    margin-bottom: 16px;
  }
  .sum-head {
    background: var(--brand-lt);
    border-bottom: 1.5px solid var(--border);
    padding: 12px 16px;
    font-size: 11px;
    font-weight: 600;
    color: var(--brand-dk);
    text-transform: uppercase;
    letter-spacing: .7px;
  }
  .sum-body { padding: 16px; }
  .sum-row {
    display: flex;
    justify-content: space-between;
    font-size: 13px;
    padding: 8px 0;
    border-bottom: 1px solid #f0ebe3;
  }
  .sum-row:last-of-type { border-bottom: none; }
  .sum-row .lbl { color: var(--muted); }
  .sum-row .val { font-weight: 600; }
  .sum-total {
    display: flex;
    justify-content: space-between;
    padding-top: 12px;
    margin-top: 4px;
    border-top: 1.5px solid var(--border);
  }
  .sum-total .lbl { font-size: 14px; font-weight: 700; }
  .sum-total .val { font-size: 16px; font-weight: 700; color: var(--green); }

  /* ── Cancel order button ── */
  .btn-cancel-order {
    width: 100%;
    background: none;
    border: 1px solid var(--red-br);
    color: var(--red);
    border-radius: 10px;
    padding: 11px;
    font-size: 13px;
    font-weight: 600;
    font-family: 'Poppins', sans-serif;
    cursor: pointer;
    display: none; /* shown by JS only when all items are Pending */
    align-items: center;
    justify-content: center;
    gap: 7px;
    transition: .2s;
  }
  .btn-cancel-order:hover { background: var(--red-lt); border-color: var(--red); }

  /* ── Modals ── */
  .modal-header {
    background: var(--brand);
    color: var(--white);
    border-radius: 8px 8px 0 0;
  }
  .modal-header .btn-close { filter: brightness(0) invert(1); opacity: .85; }
  .modal-title { font-size: .95rem; font-weight: 700; }
  .form-label { font-size: .78rem; font-weight: 600; color: #555; margin-bottom: 3px; }
  .form-control, .form-select { font-size: .82rem; padding: .32rem .6rem; }
  .form-control:focus, .form-select:focus {
    border-color: var(--brand);
    box-shadow: 0 0 0 .15rem rgba(174,148,109,.25);
  }
  .field-error { font-size: 10px; color: var(--red); margin-top: 3px; min-height: 14px; }
  .btn-confirm-danger {
    background: var(--red);
    border: none;
    color: var(--white);
    font-size: .85rem;
    font-weight: 600;
    padding: .4rem 1.4rem;
    border-radius: 6px;
    cursor: pointer;
    transition: .2s;
  }
  .btn-confirm-danger:hover { background: #a93226; }
  .btn-confirm-danger:disabled { opacity: .6; cursor: not-allowed; }
  .btn-save {
    background: var(--brand);
    border: none;
    color: var(--white);
    font-size: .85rem;
    font-weight: 600;
    padding: .4rem 1.4rem;
    border-radius: 6px;
    cursor: pointer;
    transition: .2s;
  }
  .btn-save:hover { background: var(--brand-dk); }
  .btn-save:disabled { opacity: .6; cursor: not-allowed; }

  /* ── Responsive ── */
  @media (max-width: 768px) {
    .wl-table { display: block; }
    .wl-table thead { display: none; }
    .wl-table tbody, .wl-table tr, .wl-table td { display: block; width: 100%; }
    .wl-table tr { padding: 15px; border-bottom: 1px solid #eee; }
    .wl-table td { text-align: left !important; padding: 8px 0; }
    .wl-table td::before {
      content: attr(data-label);
      display: block;
      font-size: 10px;
      font-weight: 600;
      color: var(--brand-dk);
      text-transform: uppercase;
      letter-spacing: .5px;
      margin-bottom: 3px;
    }
    .btn-item-cancel, .btn-item-return { width: 100%; }
  }
</style>
</head>
<body>

<%- include('../partials/header') %>
<%- include('../partials/toast') %>

<section class="py-5">
  <div class="container">

    <!-- ── Page Header ── -->
    <div class="order-header">
      <div>
        <h1 class="page-title">
          <i class="bi bi-receipt"></i>
          <span id="orderIdTitle">Order</span>
        </h1>
        <div class="order-meta">
          <span id="orderDate"></span>
          <span id="orderStatusBadge"></span>
          <span class="status-sub" id="orderProgress" style="margin-top:0;"></span>
        </div>
      </div>
      <div class="header-actions">
        <a href="/orders" class="btn-back">
          <i class="bi bi-arrow-left"></i> Back to Orders
        </a>
        <a href="#" class="btn-invoice" id="invoiceBtn">
          <i class="bi bi-file-earmark-arrow-down"></i> Download Invoice
        </a>
      </div>
    </div>

    <div class="row g-4 align-items-start">

      <!-- ── LEFT ── -->
      <div class="col-lg-8">

        <!-- Order Items -->
        <div class="wl-card">
          <table class="wl-table">
            <thead>
              <tr>
                <th>Product</th>
                <th>Qty</th>
                <th>Price</th>
                <th>Total</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="orderItemsBody">
              <tr>
                <td colspan="6" class="text-center py-4">
                  <div class="spinner-border"
                    style="width:24px;height:24px;border-width:2px;color:#AE946D;"></div>
                </td>
              </tr>
            </tbody>
          </table>
        </div>

        <!-- Shipping Address (snapshot from the order) -->
        <div class="wl-card">
          <div class="wl-head"><i class="bi bi-geo-alt me-1"></i> Shipping Address</div>
          <div class="wl-body" id="shippingAddress"></div>
        </div>

        <!-- Order Timeline -->
        <div class="wl-card">
          <div class="wl-head"><i class="bi bi-clock-history me-1"></i> Order Timeline</div>
          <div class="wl-body">
            <div class="timeline" id="orderTimeline"></div>
          </div>
        </div>

      </div>

      <!-- ── RIGHT ── -->
      <div class="col-lg-4">

        <!-- Price Details -->
        <div class="sum-card">
          <div class="sum-head"><i class="bi bi-receipt me-1"></i> Price Details</div>
          <div class="sum-body">
            <div class="sum-row">
              <span class="lbl">Subtotal</span>
              <span class="val" id="summarySubtotal">₹0</span>
            </div>
            <div class="sum-row">
              <span class="lbl">Shipping</span>
              <span class="val" id="summaryShipping">₹0</span>
            </div>
            <div class="sum-row">
              <span class="lbl">Discount</span>
              <span class="val" style="color:var(--green);" id="summaryDiscount">-₹0</span>
            </div>
            <div class="sum-total">
              <span class="lbl">Grand Total</span>
              <span class="val" id="summaryTotal">₹0</span>
            </div>
          </div>
        </div>

        <!-- Payment Information -->
        <div class="sum-card">
          <div class="sum-head"><i class="bi bi-credit-card me-1"></i> Payment Information</div>
          <div class="sum-body">
            <div class="sum-row">
              <span class="lbl">Method</span>
              <span class="val" id="paymentMethod"></span>
            </div>
            <div class="sum-row">
              <span class="lbl">Status</span>
              <span id="paymentStatus"></span>
            </div>
          </div>
        </div>

        <!-- Cancel whole order — visible only when all items are Pending -->
        <button class="btn-cancel-order" id="cancelOrderBtn">
          <i class="bi bi-x-circle"></i> Cancel Order
        </button>

      </div>

    </div>
  </div>
</section>

<!-- ── Cancel Modal (reason OPTIONAL) ── -->
<div class="modal fade" id="cancelModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="bi bi-x-circle me-2"></i><span id="cancelModalTitle">Cancel Item</span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p style="font-size:13px;color:#555;" id="cancelModalText">
          Are you sure you want to cancel this item?
        </p>
        <label class="form-label">
          Reason <span style="color:#aaa;font-weight:400;">(optional)</span>
        </label>
        <select id="cancelReason" class="form-select mb-2">
          <option value="">Select a reason</option>
          <option>Ordered by mistake</option>
          <option>Found a better price elsewhere</option>
          <option>Delivery is taking too long</option>
          <option>Changed my mind</option>
          <option>Other</option>
        </select>
        <textarea id="cancelComment" class="form-control" rows="2"
          placeholder="Any additional comments (optional)"></textarea>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">
          Keep Item
        </button>
        <button type="button" class="btn-confirm-danger" id="confirmCancelBtn">
          Yes, Cancel
        </button>
      </div>
    </div>
  </div>
</div>

<!-- ── Return Modal (reason MANDATORY) ── -->
<div class="modal fade" id="returnModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">
          <i class="bi bi-arrow-return-left me-2"></i>Return Item
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <p style="font-size:13px;color:#555;">
          Tell us why you want to return this item. Our team will review your
          request and approve the return.
        </p>
        <label class="form-label">Reason *</label>
        <select id="returnReason" class="form-select">
          <option value="">Select a reason</option>
          <option>Product is damaged or defective</option>
          <option>Received wrong item</option>
          <option>Product doesn't match the description</option>
          <option>Quality is not as expected</option>
          <option>Other</option>
        </select>
        <div class="field-error" id="returnReasonError"></div>
        <label class="form-label mt-1">
          Comments <span style="color:#aaa;font-weight:400;">(optional)</span>
        </label>
        <textarea id="returnComment" class="form-control" rows="2"
          placeholder="Describe the issue"></textarea>
      </div>
      <div class="modal-footer border-0 pt-0">
        <button type="button" class="btn btn-light btn-sm px-3" data-bs-dismiss="modal">
          Close
        </button>
        <button type="button" class="btn-save" id="confirmReturnBtn">
          Submit Return Request
        </button>
      </div>
    </div>
  </div>
</div>

<%- include('../partials/logout') %>
<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/user/orderDetails.js"></script>
<script src="/js/common.js"></script>
</body>
</html>
