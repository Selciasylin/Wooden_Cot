 <style>
 /* Center Toast Container */
.custom-toast-container {
  position: fixed;
  top: 20px;              /* distance from top */
  left: 50%;
  transform: translateX(-50%);
  z-index: 9999;
}

/* Toast Design */
.custom-toast {
  background-color: #000000;
  color: #ffffff;
  border-radius: 10px;
  padding: 10px 18px;
  min-width: 280px;
  max-width: 350px;
  box-shadow: 0 8px 25px rgba(252, 252, 252, 0.663);
  font-weight: 500;
  text-align: center;
}

/* Close button clean look */
.custom-toast .btn-close {
  filter: none;
  color:white;
  opacity: 0.6;
}

.custom-toast .btn-close:hover {
  opacity: 1;
}
</style>
<div class="toast-container custom-toast-container">

  <% if (message) { %>
    <div id="liveToast" class="toast custom-toast show">
      <div class="d-flex justify-content-between align-items-center">
        
        <div class="toast-body">
          <%= message.text %>
        </div>

        <button type="button" class="btn-close" onclick="closeToast()"></button>
      </div>
    </div>
  <% } %>

</div>
<script>
  function closeToast() {
    const toast = document.getElementById("liveToast");
    if (toast) toast.remove();
  }

  setTimeout(() => {
    closeToast();
  }, 2500);
</script>