    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
    <script>
      /* ══════════════════════════════════════════════
         SIZE checkbox (Single / Queen / King) — top level
         shows/hides the subtype row beneath it
      ══════════════════════════════════════════════ */
      function onSizeCheck(prefix, size) {
        const chkId =
          size === "single"
            ? prefix === "add"
              ? "chk-single"
              : "chk-edit-single"
            : prefix + "-" + size === "add-queen"
              ? "chk-queen"
              : prefix === "add"
                ? "chk-" + size
                : "chk-edit-" + size;
        // simpler direct approach:
        const chk = document.getElementById(
          size === "single"
            ? prefix === "add"
              ? "chk-single"
              : "chk-edit-single"
            : prefix === "add"
              ? "chk-" + size
              : "chk-edit-" + size,
        );
        const subtypes = document.getElementById(
          prefix + "-" + size + "-subtypes",
        );
        if (!subtypes) return;
        subtypes.classList.toggle("show", chk.checked);
        // If unchecked, also collapse all sub-checkboxes
        if (!chk.checked) {
          subtypes.querySelectorAll('input[type="checkbox"]').forEach((c) => {
            c.checked = false;
          });
          subtypes
            .querySelectorAll(".subtype-fields")
            .forEach((f) => f.classList.remove("show"));
        }
      }

      /* ══════════════════════════════════════════════
         SUB-TYPE checkbox (With Drawer / Without Drawer)
         shows/hides the qty+price fields beneath it
      ══════════════════════════════════════════════ */
      function onSubCheck(prefix, size, type) {
        const chk = document.getElementById(
          prefix + "-chk-" + size + "-" + type,
        );
        const fields = document.getElementById(
          prefix + "-" + size + "-" + type + "-fields",
        );
        if (!chk || !fields) return;
        fields.classList.toggle("show", chk.checked);
      }

      /* ══════════════════════════════════════════════
         VIEW modal — Queen/King header click toggle
      ══════════════════════════════════════════════ */
      function toggleViewSize(size) {
        const fields = document.getElementById("viewFields" + size);
        const chk = document.getElementById("viewChk" + size);
        const open = fields.classList.toggle("show");
        if (chk) chk.checked = open;
      }

      /* ══════════════════════════════════════════════
         IMAGE CROP — shared state
      ══════════════════════════════════════════════ */
      let cropperInstance = null;
      let cropSlotIndex = 0;
      let cropModalPrefix = "add"; // 'add' or 'edit'
      let totalSlots = 4;

      function triggerFileInput(i) {
        document.getElementById("fileInput-" + i).click();
      }
      function triggerEditFileInput(i) {
        document.getElementById("editFileInput-" + i).click();
      }

      function openCrop(index, input, prefix) {
        if (!input.files || !input.files[0]) return;

        const file = input.files[0];
        const imageError =
          prefix === "add"
            ? document.getElementById("error-image")
            : document.getElementById("edit-error-image");
        imageError.textContent = "";
        const validationError = validateImageFile(file);

        if (validationError) {
          imageError.textContent = validationError;
          input.value = "";
          return;
        }
        cropSlotIndex = index;
        cropModalPrefix = prefix;

        const reader = new FileReader();
        reader.onload = (e) => {
          const cropImg = document.getElementById("cropImage");

          if (cropperInstance) {
            cropperInstance.destroy();
            cropperInstance = null;
          }

          cropImg.src = ""; // ← RESET first
          cropImg.src = e.target.result;

          document.getElementById("cropCounter").textContent =
            index + 1 + "/" + totalSlots;
          document.getElementById("cropOverlay").classList.add("show");

          cropImg.onload = () => {
            cropperInstance = new Cropper(cropImg, {
              aspectRatio: 332.65 / 288.3,
              viewMode: 1,
              autoCropArea: 0.85,
            });
          };
        };
        reader.readAsDataURL(input.files[0]);
        input.value = "";
      }

      function applyCrop() {
        if (!cropperInstance) return;

        const canvas = cropperInstance.getCroppedCanvas({
          width: 600,
          height: 600,
        });

        const prefix = cropModalPrefix;
        const i = cropSlotIndex;

        const inputId =
          prefix === "add" ? `fileInput-${i}` : `editFileInput-${i}`;

        const slotId = prefix === "add" ? `slot-${i}` : `edit-slot-${i}`;

        const removeFn = prefix === "add" ? "removeSlot" : "removeEditSlot";

        // 🔥 IMPORTANT PART (THIS FIXES YOUR BUG)
        canvas.toBlob(
          (blob) => {
            const file = new File([blob], "cropped.jpg", {
              type: "image/jpeg",
            });

            const dataTransfer = new DataTransfer();
            dataTransfer.items.add(file);

            // ✅ Assign file to input (VERY IMPORTANT)
            document.getElementById(inputId).files = dataTransfer.files;

            // ✅ Preview
            const url = URL.createObjectURL(blob);

            document.getElementById(slotId).innerHTML = `
      <img src="${url}" alt="Preview">
      <button class="slot-remove" onclick="${removeFn}(event,${i})">
        <i class="bi bi-x"></i>
      </button>
    `;
          },
          "image/jpeg",
          0.9,
        );

        cancelCrop();
      }

      function cancelCrop() {
        if (cropperInstance) {
          cropperInstance.destroy();
          cropperInstance = null;
        }
        document.getElementById("cropOverlay").classList.remove("show");
      }

      function removeSlot(event, i) {
        event.stopPropagation();

        document.getElementById(`fileInput-${i}`).value = ""; // 🔥 clear file

        document.getElementById("slot-" + i).innerHTML =
          `<span class="slot-placeholder"><i class="bi bi-image"></i>Add Photo</span>`;
      }

      function removeEditSlot(event, i) {
        event.stopPropagation();

        document.getElementById(`editFileInput-${i}`).value = "";

        // remove existing image from array
        if (window.currentImages && window.currentImages[i]) {
          window.currentImages.splice(i, 1);
        }

        document.getElementById(`edit-slot-${i}`).innerHTML = `
          <span class="slot-placeholder">
            <i class="bi bi-image"></i>Add Photo
          </span>
        `;
      }
      /* ══════════════════════════════════════════════
         OPEN MODALS
      ══════════════════════════════════════════════ */
      function openViewModal() {
        // Single — With Drawer data
        document.getElementById("viewSingleDrawerQty").textContent = "10";
        document.getElementById("viewSingleDrawerPrice").textContent = "₹1,800";
        // Single — Without Drawer data
        document.getElementById("viewSingleNoDrawerQty").textContent = "8";
        document.getElementById("viewSingleNoDrawerPrice").textContent =
          "₹1,500";

        // Queen has data
        document.getElementById("viewQueenDrawerQty").textContent = "5";
        document.getElementById("viewQueenDrawerPrice").textContent = "₹2,400";
        document.getElementById("viewQueenNoDrawerQty").textContent = "3";
        document.getElementById("viewQueenNoDrawerPrice").textContent =
          "₹2,100";
        document.getElementById("viewChkQueen").checked = true;
        document.getElementById("viewFieldsQueen").classList.add("show");

        // King — no data, stays collapsed
        document.getElementById("viewChkKing").checked = false;
        document.getElementById("viewFieldsKing").classList.remove("show");

        new bootstrap.Modal(document.getElementById("viewProductModal")).show();
      }

      function openEditModal() {
        new bootstrap.Modal(document.getElementById("editProductModal")).show();
      }
    </script>
    <script id="variant-data" type="application/json">
  <%- JSON.stringify(variants || []) %>
</script>
  
    <script src="/js/admin/product.js"></script>
  </body>
