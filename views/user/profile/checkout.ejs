<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Checkout — Wooden Cot</title>
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css"
      rel="stylesheet"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css"
      rel="stylesheet"
    />
    <style>
      :root {
        --brand: #ae946d;
        --brand-dk: #9a8260;
        --brand-lt: #f5ede0;
        --border: #e8e0d5;
      }
      body {
        font-family: "Poppins", sans-serif;
        background: #f9f6f2;
      }
      .navbar {
        background: var(--brand);
      }
      .navbar-brand {
        font-weight: 700;
        font-size: 20px;
        color: #fff !important;
      }
      .nav-link-white {
        color: #fff !important;
        font-size: 13px;
        text-decoration: none;
      }
      .nav-link-white:hover {
        opacity: 0.8;
      }

      .page-title {
        font-size: 22px;
        font-weight: 600;
        color: var(--brand);
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 1.5rem;
      }
      .sec-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 20px;
        margin-bottom: 16px;
      }
      .sec-title {
        font-size: 11px;
        font-weight: 700;
        color: var(--brand-dk);
        text-transform: uppercase;
        letter-spacing: 0.8px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
      }

      /* Address scroll */
      .addr-scroll {
        display: flex;
        gap: 12px;
        overflow-x: auto;
        padding-bottom: 8px;
        -webkit-overflow-scrolling: touch;
      }
      .addr-scroll::-webkit-scrollbar {
        height: 4px;
      }
      .addr-scroll::-webkit-scrollbar-thumb {
        background: var(--border);
        border-radius: 4px;
      }
      .addr-card {
        min-width: 200px;
        flex-shrink: 0;
        border: 2px solid var(--border);
        border-radius: 12px;
        padding: 14px 16px;
        cursor: pointer;
        transition: 0.2s;
        position: relative;
        background: #fdfcfa;
      }
      .addr-card:hover,
      .addr-card.selected {
        border-color: var(--brand);
        background: var(--brand-lt);
      }
      .addr-dot {
        display: none;
        position: absolute;
        top: 10px;
        right: 10px;
        width: 18px;
        height: 18px;
        background: var(--brand);
        border-radius: 50%;
        align-items: center;
        justify-content: center;
      }
      .addr-dot i {
        color: #fff;
        font-size: 10px;
      }
      .addr-card.selected .addr-dot {
        display: flex;
      }
      .addr-type {
        font-size: 11px;
        font-weight: 700;
        color: var(--brand);
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 5px;
      }
      .addr-name {
        font-size: 13px;
        font-weight: 600;
        color: #2c2c2c;
        margin-bottom: 3px;
      }
      .addr-line {
        font-size: 11px;
        color: #888;
        line-height: 1.7;
      }
      .btn-add-addr {
        min-width: 110px;
        flex-shrink: 0;
        border: 2px dashed var(--border);
        border-radius: 12px;
        padding: 14px 16px;
        background: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        color: #bbb;
        font-size: 12px;
        font-family: "Poppins", sans-serif;
        cursor: pointer;
        transition: 0.2s;
      }
      .btn-add-addr:hover {
        border-color: var(--brand);
        color: var(--brand);
      }
      .btn-add-addr i {
        font-size: 22px;
      }

      /* Payment */
      .pay-item {
        border: 2px solid var(--border);
        border-radius: 12px;
        padding: 13px 18px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: 0.2s;
        background: #fdfcfa;
      }
      .pay-item:hover,
      .pay-item.selected {
        border-color: var(--brand);
        background: var(--brand-lt);
      }
      .pay-label {
        font-size: 13px;
        font-weight: 600;
        color: #2c2c2c;
      }
      .pay-sub {
        font-size: 11px;
        color: #999;
        margin-top: 2px;
      }
      .pay-check {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 2px solid var(--border);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
        flex-shrink: 0;
      }
      .pay-item.selected .pay-check {
        background: var(--brand);
        border-color: var(--brand);
      }
      .pay-item.selected .pay-check i {
        color: #fff;
        font-size: 11px;
      }

      /* Order items table */
      .checkout-table {
        width: 100%;
        border-collapse: collapse;
      }
      .checkout-table th {
        font-size: 11px;
        font-weight: 600;
        color: #999;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        padding: 8px 10px;
        border-bottom: 1px solid var(--border);
      }
      .checkout-table td {
        padding: 12px 10px;
        border-bottom: 1px solid var(--border);
        font-size: 13px;
        vertical-align: middle;
      }
      .checkout-table tr:last-child td {
        border-bottom: none;
      }
      .prod-cell {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .prod-img {
        width: 52px;
        height: 52px;
        object-fit: cover;
        border-radius: 8px;
        border: 1px solid var(--border);
      }
      .prod-name {
        font-size: 13px;
        font-weight: 500;
        color: #2c2c2c;
      }
      .badge-variant {
        background: var(--brand-lt);
        color: var(--brand-dk);
        font-size: 10px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 20px;
      }
      .qty-badge {
        font-size: 13px;
        font-weight: 600;
        color: #555;
      }
      .price-val {
        font-size: 13px;
        color: #555;
      }
      .total-val {
        font-size: 13px;
        font-weight: 700;
        color: #2c2c2c;
      }

      /* Summary */
      .summary-card {
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 22px;
        position: sticky;
        top: 20px;
      }
      .summary-title {
        font-size: 14px;
        font-weight: 700;
        color: #2c2c2c;
        margin-bottom: 18px;
        padding-bottom: 12px;
        border-bottom: 1px solid var(--border);
      }
      .summary-row {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        margin-bottom: 10px;
      }
      .summary-row .lbl {
        color: #888;
      }
      .summary-row .val {
        font-weight: 500;
        color: #2c2c2c;
      }
      .summary-row.discount .val {
        color: #2e7d32;
      }
      .summary-divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 12px 0;
      }
      .summary-total {
        display: flex;
        justify-content: space-between;
        font-size: 15px;
        font-weight: 700;
        color: #2c2c2c;
      }
      .btn-place {
        width: 100%;
        background: var(--brand);
        color: #fff;
        border: none;
        border-radius: 10px;
        padding: 13px;
        font-size: 15px;
        font-weight: 700;
        font-family: "Poppins", sans-serif;
        cursor: pointer;
        transition: 0.2s;
        margin-top: 18px;
      }
      .btn-place:hover {
        background: var(--brand-dk);
      }
      .secure-note {
        font-size: 11px;
        color: #aaa;
        text-align: center;
        margin-top: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
      }

      /* Modal */
      .modal-header {
        background: var(--brand);
        color: #fff;
        border-radius: 8px 8px 0 0;
      }
      .modal-header .btn-close {
        filter: brightness(0) invert(1);
        opacity: 0.85;
      }
      .modal-title {
        font-size: 0.95rem;
        font-weight: 700;
      }
      .form-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: #555;
        margin-bottom: 3px;
      }
      .form-control,
      .form-select {
        font-size: 0.82rem;
        padding: 0.32rem 0.6rem;
      }
      .form-control:focus,
      .form-select:focus {
        border-color: var(--brand);
        box-shadow: 0 0 0 0.15rem rgba(174, 148, 109, 0.25);
      }
      .form-control.is-invalid,
      .form-select.is-invalid {
        border-color: #c0392b;
      }
      .btn-save {
        background: var(--brand);
        border: none;
        color: #fff;
        font-size: 0.85rem;
        font-weight: 600;
        padding: 0.4rem 1.4rem;
        border-radius: 6px;
        cursor: pointer;
        transition: 0.2s;
      }
      .btn-save:hover {
        background: var(--brand-dk);
      }
      .btn-save:disabled {
        opacity: 0.6;
        cursor: not-allowed;
      }
      .field-error {
        font-size: 10px;
        color: #c0392b;
        margin-top: 3px;
        min-height: 14px;
      }

      /* Confirm modal */
      .confirm-row {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        font-size: 13px;
        padding: 10px 0;
        border-bottom: 1px solid var(--border);
      }
      .confirm-row:last-child {
        border-bottom: none;
      }
      .confirm-row .lbl {
        color: #888;
        flex-shrink: 0;
      }
      .confirm-row .val {
        font-weight: 600;
        color: #2c2c2c;
        text-align: right;
        max-width: 65%;
      }
      .confirm-total-val {
        font-size: 17px;
        font-weight: 700;
        color: var(--brand);
      }

      /* Toast */
      .toast-container {
        position: fixed;
        bottom: 24px;
        right: 24px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 8px;
      }
      .custom-toast {
        min-width: 220px;
        padding: 12px 18px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 500;
        color: #fff;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.15);
        animation: slideIn 0.3s ease;
      }
      .custom-toast.success {
        background: #2e7d32;
      }
      .custom-toast.error {
        background: #c0392b;
      }
      @keyframes slideIn {
        from {
          transform: translateY(20px);
          opacity: 0;
        }
        to {
          transform: translateY(0);
          opacity: 1;
        }
      }

      @media (max-width: 576px) {
        .checkout-table th:nth-child(3),
        .checkout-table td:nth-child(3) {
          display: none;
        }
      }
    </style>
  </head>
  <body>
    <!-- Navbar -->
    <%- include('../partials/header') %> <%- include('../partials/toast') %>

    <div class="container py-4">
      <div class="page-title"><i class="bi bi-bag-check"></i> Checkout</div>

      <div class="row g-4">
        <!-- LEFT -->
        <div class="col-lg-8">
          <!-- Address -->
          <div class="sec-card">
            <div class="sec-title">
              <i class="bi bi-geo-alt"></i> Delivery Address
            </div>
            <div class="addr-scroll">
              <div id="addressContainer" style="display: contents"></div>
              <button
                class="btn-add-addr"
                data-bs-toggle="modal"
                data-bs-target="#addAddressModal"
              >
                <i class="bi bi-plus-circle"></i>
                Add Address
              </button>
            </div>
          </div>

          <!-- Payment -->
           
<div class="sec-card">
  <div class="sec-title">
    <i class="bi bi-credit-card"></i> Payment Method
  </div>

  <div class="d-flex flex-column gap-2">

    <div class="pay-item selected" data-payment="COD">
      <div>
        <div class="pay-label">
          <i class="bi bi-cash-coin me-2"></i>
          Cash on Delivery
        </div>
        <div class="pay-sub">
          Pay when your order arrives
        </div>
      </div>
      <div class="pay-check">
        <i class="bi bi-check"></i>
      </div>
    </div>

    <div class="pay-item" data-payment="RAZORPAY">
      <div>
        <div class="pay-label">
          <i class="bi bi-credit-card me-2"></i>
          Razorpay
        </div>
        <div class="pay-sub">
          Coming Soon
        </div>
      </div>
      <div class="pay-check">
        <i class="bi bi-check"></i>
      </div>
    </div>

    <div class="pay-item" data-payment="WALLET">
      <div>
        <div class="pay-label">
          <i class="bi bi-wallet2 me-2"></i>
          Wallet
        </div>
        <div class="pay-sub">
          Coming Soon
        </div>
      </div>
      <div class="pay-check">
        <i class="bi bi-check"></i>
      </div>
    </div>

  </div>
</div>
</div>

      

        <!-- RIGHT — Summary -->
        <div class="col-lg-4">
          <!-- Order Items -->
          <div class="sec-card">
            <div class="sec-title"><i class="bi bi-bag"></i> Order Items</div>
            <table class="checkout-table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th>Qty</th>
                  <th>Price</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody id="checkoutBody">
                <tr>
                  <td colspan="4" class="text-center py-4">
                    <div
                      class="spinner-border"
                      style="
                        width: 24px;
                        height: 24px;
                        border-width: 2px;
                        color: #ae946d;
                      "
                    ></div>
                  </td>
                </tr>
              </tbody>
            </table>
          </div>
          <div class="summary-card">
            <div class="summary-title">Order Summary</div>
            <div class="summary-row">
              <span class="lbl">Subtotal</span>
              <span class="val" id="summarySubtotal">₹0</span>
            </div>
            <div class="summary-row">
              <span class="lbl">Shipping</span>
              <span class="val" id="summaryShipping">₹100</span>
            </div>
            <div class="summary-row discount">
              <span class="lbl">Discount</span>
              <span class="val" id="summaryDiscount">-₹0</span>
            </div>
            <hr class="summary-divider" />
            <div class="summary-total">
              <span>Total</span>
              <span id="summaryTotal">₹0</span>
            </div>
            <button class="btn-place" id="openConfirmBtn">
              <i class="bi bi-lock-fill me-2"></i>Place Order
            </button>
            <div class="secure-note">
              <i class="bi bi-shield-check"></i> Secure &amp; Safe Checkout
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- ── Add Address Modal ─────────────────────────────────────────────────────── -->
    <div class="modal fade" id="addAddressModal" tabindex="-1">
      <div class="modal-dialog modal-dialog-scrollable">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">
              <i class="bi bi-geo-alt me-2"></i>Add New Address
            </h5>
            <button
              type="button"
              class="btn-close"
              data-bs-dismiss="modal"
            ></button>
          </div>
          <div class="modal-body">
            <form id="addAddressForm" novalidate>
              <div class="row g-2">
                <div class="col-md-6">
                  <label class="form-label">Full Name *</label>
                  <input
                    type="text"
                    id="fullName"
                    class="form-control"
                    placeholder="e.g. Ravi Kumar"
                  />
                  <div class="field-error" id="fullNameError"></div>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Phone *</label>
                  <input
                    type="text"
                    id="phone"
                    class="form-control"
                    maxlength="10"
                    placeholder="10-digit number"
                  />
                  <div class="field-error" id="phoneError"></div>
                </div>
                <div class="col-12">
                  <label class="form-label">Address Line 1 *</label>
                  <input
                    type="text"
                    id="addressLine1"
                    class="form-control"
                    placeholder="House no, Street, Area"
                  />
                  <div class="field-error" id="addressLine1Error"></div>
                </div>
                <div class="col-12">
                  <label class="form-label"
                    >Address Line 2
                    <span style="color: #aaa; font-weight: 400"
                      >(optional)</span
                    ></label
                  >
                  <input
                    type="text"
                    id="addressLine2"
                    class="form-control"
                    placeholder="Landmark, Colony"
                  />
                </div>
                <div class="col-md-6">
                  <label class="form-label">City *</label>
                  <input
                    type="text"
                    id="city"
                    class="form-control"
                    placeholder="e.g. Kochi"
                  />
                  <div class="field-error" id="cityError"></div>
                </div>
                <div class="col-md-6">
                  <label class="form-label">State *</label>
                  <select id="state" class="form-select">
                    <option value="">Select State</option>
                    <option>Andhra Pradesh</option>
                    <option>Arunachal Pradesh</option>
                    <option>Assam</option>
                    <option>Bihar</option>
                    <option>Chhattisgarh</option>
                    <option>Goa</option>
                    <option>Gujarat</option>
                    <option>Haryana</option>
                    <option>Himachal Pradesh</option>
                    <option>Jharkhand</option>
                    <option>Karnataka</option>
                    <option>Kerala</option>
                    <option>Madhya Pradesh</option>
                    <option>Maharashtra</option>
                    <option>Manipur</option>
                    <option>Meghalaya</option>
                    <option>Mizoram</option>
                    <option>Nagaland</option>
                    <option>Odisha</option>
                    <option>Punjab</option>
                    <option>Rajasthan</option>
                    <option>Sikkim</option>
                    <option>Tamil Nadu</option>
                    <option>Telangana</option>
                    <option>Tripura</option>
                    <option>Uttar Pradesh</option>
                    <option>Uttarakhand</option>
                    <option>West Bengal</option>
                    <option>Delhi</option>
                    <option>Jammu and Kashmir</option>
                    <option>Ladakh</option>
                    <option>Puducherry</option>
                  </select>
                  <div class="field-error" id="stateError"></div>
                </div>
                <div class="col-md-6">
                  <label class="form-label">PIN Code *</label>
                  <input
                    type="text"
                    id="zip"
                    class="form-control"
                    maxlength="6"
                    placeholder="6-digit pincode"
                  />
                  <div class="field-error" id="zipError"></div>
                </div>
                <div class="col-md-6">
                  <label class="form-label">Address Type *</label>
                  <select id="addressType" class="form-select">
                    <option value="">Select Type</option>
                    <option value="Home">Home</option>
                    <option value="Office">Office</option>
                    <option value="Other">Other</option>
                  </select>
                  <div class="field-error" id="addressTypeError"></div>
                </div>
                <div class="col-12 mt-1">
                  <div class="form-check">
                    <input
                      class="form-check-input"
                      type="checkbox"
                      id="isDefault"
                    />
                    <label
                      class="form-check-label"
                      for="isDefault"
                      style="font-size: 0.82rem"
                      >Set as default address</label
                    >
                  </div>
                </div>
              </div>
            </form>
          </div>
          <div class="modal-footer border-0 pt-0">
            <button
              type="button"
              class="btn btn-light btn-sm px-3"
              data-bs-dismiss="modal"
            >
              Cancel
            </button>
            <button type="button" class="btn-save" id="saveAddressBtn">
              Save Address
            </button>
          </div>
        </div>
      </div>
    </div>
    <div
  class="modal fade"
  id="deleteAddressModal"
  tabindex="-1">

  <div class="modal-dialog modal-dialog-centered">

    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">
          Delete Address
        </h5>
      </div>

      <div class="modal-body text-center">

        <i
          class="bi bi-trash3"
          style="font-size:50px;color:#dc3545;">
        </i>

        <p class="mt-3">
          Are you sure you want to delete this address?
        </p>

      </div>

      <div class="modal-footer">

        <button
          class="btn btn-light"
          data-bs-dismiss="modal">

          Cancel

        </button>

        <button
          class="btn btn-danger"
          id="confirmDeleteBtn">

          Delete

        </button>

      </div>

    </div>

  </div>

</div>
<div
 class="modal fade"
 id="thankYouModal"
 tabindex="-1">

 <div
 class="modal-dialog modal-dialog-centered">

 <div class="modal-content">

 <div class="modal-body text-center p-5">

 <i
 class="bi bi-check-circle-fill"
 style="
 color:#28a745;
 font-size:70px;">
 </i>

 <h4 class="mt-3">
 Thank You!
 </h4>

 <p>
 Your order has been placed successfully.
 </p>

 <div
 class="d-flex gap-2 justify-content-center">

 <a
 href="/shop"
 class="btn btn-success">

 Continue Shopping

 </a>

 <button
 class="btn btn-outline-secondary">

 Order Details

 </button>

 </div>

 </div>

 </div>

 </div>

</div>

    <%- include('../partials/footer') %>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/user/checkout.js"></script>
    <script src="/js/common.js"></script>
  </body>
</html>
