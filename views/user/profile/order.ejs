<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Orders — Wooden Cot</title>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.min.css" rel="stylesheet">

<style>
  /* ── Variables ── */
  :root {
    --brand:    #AE946D;
    --brand-dk: #9a8260;
    --brand-lt: #f5ede0;
    --text:     #2c2c2c;
    --muted:    #888;
    --border:   #e8e0d5;
    --white:    #ffffff;
    --bg:       #f9f6f2;
    --card-bg:  #fdfcfa;
    --green:    #2e7d32;
    --red:      #c0392b;
  }

  /* ── Base ── */
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Poppins', sans-serif;
    background: var(--bg);
    color: var(--text);
    font-size: 16px;
  }

  /* ── Navbar / Footer ── */
  .navbar-custom { background-color: #AE946D; }
  .footer-custom { background-color: #CDAF82; }

  /* ── Page Title ── */
  .page-title {
    font-size: 22px;
    font-weight: 600;
    color: var(--brand);
    letter-spacing: .5px;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .page-title i { font-size: 20px; }

  /* ── Sidebar (same as wishlist/profile page) ── */
  .sidebar-menu {
    background-color: white;
    border-radius: 10px;
  }
  .sidebar-menu .nav-link {
    color: #666;
    padding: 12px 20px;
    border-radius: 5px;
    margin-bottom: 5px;
    transition: all 0.3s;
  }
  .sidebar-menu .nav-link:hover {
    background-color: #f8f8f8;
    color: #AE946D;
  }
  .sidebar-menu .nav-link.active {
    background-color: #AE946D;
    color: white;
  }
  .profile-img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid #AE946D;
  }

  /* ── Toolbar ── */
  .toolbar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
    flex-wrap: wrap;
  }
  .item-count {
    font-size: 12px;
    color: var(--muted);
    margin-left: auto;
    white-space: nowrap;
  }

  /* ── Search ── */
  .order-search {
    position: relative;
    width: 260px;
    max-width: 100%;
  }
  .order-search input {
    width: 100%;
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 8px 34px 8px 12px;
    font-size: 13px;
    font-family: 'Poppins', sans-serif;
    outline: none;
    background: var(--white);
    transition: border-color .2s;
  }
  .order-search input:focus { border-color: var(--brand); }
  .order-search i {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    font-size: 14px;
  }

  /* ── Table Card ── */
  .wl-card {
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
  }

  /* ── Table ── */
  .wl-table {
    width: 100%;
    border-collapse: collapse;
    table-layout: fixed;
  }
  .wl-table thead tr {
    background: var(--brand-lt);
    border-bottom: 1.5px solid var(--border);
  }
  .wl-table thead th {
    padding: 12px 16px;
    font-size: 11px;
    font-weight: 600;
    color: var(--brand-dk);
    text-transform: uppercase;
    letter-spacing: .7px;
  }
  .wl-table thead th:nth-child(1) { width: 21%; }
  .wl-table thead th:nth-child(2) { width: 17%; }
  .wl-table thead th:nth-child(3) { width: 21%; }
  .wl-table thead th:nth-child(4) { width: 13%; text-align: right; }
  .wl-table thead th:nth-child(5) { width: 17%; text-align: center; }
  .wl-table thead th:nth-child(6) { width: 11%; text-align: center; }

  .wl-table tbody tr {
    border-bottom: 1px solid #f0ebe3;
    transition: background .15s;
  }
  .wl-table tbody tr:last-child { border-bottom: none; }
  .wl-table tbody tr:hover { background: #fdf9f5; }
  .wl-table tbody td {
    padding: 14px 16px;
    vertical-align: middle;
  }
  .wl-table tbody td:nth-child(4) { text-align: right; }
  .wl-table tbody td:nth-child(5) { text-align: center; }
  .wl-table tbody td:nth-child(6) { text-align: center; }

  /* ── Cells ── */
  .order-id {
    font-size: 12px;
    font-weight: 700;
    color: var(--brand-dk);
    word-break: break-all;
  }
  .order-date { font-size: 12px; color: var(--muted); }

  .items-cell { display: flex; align-items: center; gap: 12px; }
  .items-thumb {
    width: 46px;
    height: 46px;
    border-radius: 10px;
    object-fit: cover;
    border: 1px solid var(--border);
    background: #f0ebe3;
    flex-shrink: 0;
  }
  .items-count { font-size: 12px; font-weight: 600; color: var(--text); }

  .total-val { font-size: 13px; font-weight: 700; color: var(--text); }

  /* ── Status badges ── */
  .status-badge {
    font-size: 10.5px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: 20px;
    display: inline-block;
    white-space: nowrap;
  }
  .st-pending    { background: #fff5e0; color: #b07d1a; }
  .st-shipped    { background: #e3f0fb; color: #2471a3; }
  .st-partial    { background: #e3f0fb; color: #2471a3; }
  .st-delivered  { background: #e4f4e6; color: #2e7d32; }
  .st-cancelled  { background: #fdeaea; color: #c0392b; }
  .st-requested  { background: #fdf3e3; color: #b07d1a; }
  .st-returned   { background: #efeaf6; color: #6c4ea0; }
  .st-rejected   { background: #fdeaea; color: #c0392b; }
  .status-sub {
    display: block;
    font-size: 10px;
    color: var(--muted);
    margin-top: 4px;
  }

  /* ── View button ── */
  .btn-view {
    background: var(--brand);
    color: var(--white);
    border: none;
    border-radius: 8px;
    padding: 6px 16px;
    font-size: 11px;
    font-weight: 600;
    font-family: 'Poppins', sans-serif;
    text-decoration: none;
    display: inline-block;
    transition: .2s;
  }
  .btn-view:hover { background: var(--brand-dk); color: var(--white); }

  /* ── Table Footer (pagination) ── */
  .wl-footer {
    padding: 12px 16px;
    border-top: 1px solid #f0ebe3;
    background: var(--card-bg);
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .entries-info { font-size: 12px; color: var(--muted); }
  .pagination { gap: 3px; margin: 0; }
  .pagination .page-link {
    color: var(--brand);
    border-color: var(--border);
    font-size: 12px;
    font-family: 'Poppins', sans-serif;
    padding: 5px 10px;
    border-radius: 7px !important;
    cursor: pointer;
  }
  .pagination .page-item.active .page-link {
    background: var(--brand);
    border-color: var(--brand);
    color: var(--white);
  }
  .pagination .page-link:hover {
    background: var(--brand-lt);
    color: var(--brand-dk);
  }
  .pagination .page-item.disabled .page-link { color: #ccc; }

  /* ── Empty State ── */
  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 4rem 2rem;
    gap: 12px;
    text-align: center;
  }
  .empty-state i     { font-size: 42px; color: #d5c9b8; }
  .empty-state p     { font-size: 14px; font-weight: 500; color: #555; margin: 0; }
  .empty-state small { font-size: 12px; color: var(--muted); }
  .btn-shop {
    background: var(--brand);
    color: var(--white);
    border: none;
    border-radius: 8px;
    padding: 8px 16px;
    font-size: 11px;
    font-weight: 600;
    font-family: 'Poppins', sans-serif;
    text-decoration: none;
    margin-top: 4px;
    display: inline-block;
  }
  .btn-shop:hover { background: var(--brand-dk); color: var(--white); }

  /* ── Responsive (same pattern as wishlist) ── */
  @media (max-width: 768px) {
    .wl-table { display: block; }
    .wl-table thead { display: none; }
    .wl-table tbody, .wl-table tr, .wl-table td { display: block; width: 100%; }
    .wl-table tr { padding: 15px; border-bottom: 1px solid #eee; }
    .wl-table td { text-align: left !important; padding: 8px 0; }
    .wl-table td::before {
      content: attr(data-label);
      display: block;
      font-size: 10px;
      font-weight: 600;
      color: var(--brand-dk);
      text-transform: uppercase;
      letter-spacing: .5px;
      margin-bottom: 3px;
    }
    .btn-view { width: 100%; text-align: center; }
    .order-search { width: 100%; }
    .wl-footer { justify-content: center; }
  }
</style>
</head>
<body>

<%- include('../partials/header') %>
<%- include('../partials/toast') %>

<section class="py-5">
  <div class="container">
    <div class="row g-4">

      <!-- ── Sidebar (same as wishlist/profile page) ── -->
      <div class="col-lg-3">
        <div class="sidebar-menu shadow-sm p-4">
          <!-- Profile Image and Name -->
          <div class="text-center mb-4">
            <img src="<%= user.profilePicture ? user.profilePicture : 'https://ui-avatars.com/api/?name=' + (user.firstName || 'User') + '&background=AE946D&color=fff' %>" class="profile-img mb-3">
            <h5 class="fw-semibold mb-1">
              <%= user.firstName || '' %> <%= user.lastName || '' %>
            </h5>
            <p class="text-muted small mb-0"><%= user.email %></p>
          </div>

          <hr class="my-3">

          <!-- Menu Items -->
          <nav class="nav flex-column">
            <a class="nav-link" href="/profile">
              <i class="bi bi-person me-2"></i> Account Details
            </a>
            <a class="nav-link" href="/wishlist">
              <i class="bi bi-heart me-2"></i> Wishlist
            </a>
            <a class="nav-link active" href="/orders">
              <i class="bi bi-box-seam me-2"></i> Orders
            </a>
            <a class="nav-link" href="/address">
              <i class="bi bi-geo-alt me-2"></i> Address
            </a>
            <a class="nav-link" href="/wallet">
              <i class="bi bi-wallet2 me-2"></i> My Wallet
            </a>
            <a class="nav-link text-danger" href="signOut" data-bs-toggle="modal" data-bs-target="#logoutModal">
              <i class="bi bi-box-arrow-right me-2"></i> Sign Out
            </a>
          </nav>
        </div>
      </div>
      <!-- /Sidebar -->

      <!-- ── Orders Content ── -->
      <div class="col-lg-9">

        <h1 class="page-title">
          <i class="bi bi-box-seam"></i> My Orders
        </h1>

        <!-- Toolbar -->
        <div class="toolbar">
          <div class="order-search">
            <input type="text" id="orderSearch" placeholder="Search by Order ID" autocomplete="off">
            <i class="bi bi-search"></i>
          </div>
          <span class="item-count" id="orderCount">0 orders</span>
        </div>

        <!-- Empty State -->
        <div class="wl-card" id="emptyState" style="display:none;">
          <div class="empty-state">
            <i class="bi bi-box-seam"></i>
            <p>No orders yet</p>
            <small>Looks like you haven't placed any orders</small>
            <a href="/shop" class="btn-shop">Start Shopping</a>
          </div>
        </div>

        <!-- Orders Table -->
        <div class="wl-card" id="ordersTable" style="display:none;">
          <table class="wl-table">
            <thead>
              <tr>
                <th>Order ID</th>
                <th>Date</th>
                <th>Items</th>
                <th>Total</th>
                <th>Status</th>
                <th>Action</th>
              </tr>
            </thead>
            <tbody id="ordersBody"></tbody>
          </table>

          <div class="wl-footer">
            <span class="entries-info" id="entriesInfo"></span>
            <ul class="pagination pagination-sm" id="pagination"></ul>
          </div>
        </div>

      </div>
      <!-- /Orders Content -->

    </div>
  </div>
</section>

<%- include('../partials/logout') %>
<%- include('../partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/user/orders.js"></script>
<script src="/js/common.js"></script>
</body>
</html>
